{
  "name": "app-test-multiagent-brain-extraction",
  "github": "gamorosino/app-test-multiagent-brain-extraction",
  "desc": "Skull-strip a T1w volume with FSL's bet",
  "inputs": [
    {
      "id": "t1",
      "datatype": "neuro/nifti"
    }
  ],
  "outputs": [
    {
      "id": "out",
      "datatype": "neuro/nifti"
    }
  ],
  "config": {
    "t1": {
      "type": "input",
      "input_id": "t1"
    },
    "frac": {
      "type": "float",
      "description": "BET fractional intensity threshold",
      "default": 0.5
    },
    "robust": {
      "type": "boolean",
      "description": "Use BET's robust brain center estimation",
      "default": false
    },
    "bias_neck_cleanup": {
      "type": "boolean",
      "description": "Bias field + neck cleanup",
      "default": false
    }
  },
  "invoke": "python3 brain_extract.py --t1 {t1} --out {out} --frac {frac} --robust {robust} --bias-neck-cleanup {bias_neck_cleanup}"
}
